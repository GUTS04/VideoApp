# Application
APP_NAME=VideoApp API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT (optional — defaults to SECRET_KEY if JWT_SECRET_KEY is empty)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=127.0.0.1
PORT=8001

# Database (PostgreSQL)
POSTGRES_USER=videoapp
POSTGRES_PASSWORD=videoapp
POSTGRES_DB=videoapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://videoapp:videoapp@localhost:5432/videoapp

# CORS — React dev server (Vite default port)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
