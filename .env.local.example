# Copy to .env.local for Vite (frontend)
VITE_API_URL=http://127.0.0.1:8001
# Optional: override WebSocket base (defaults to API URL with ws:// scheme)
# VITE_WS_URL=ws://127.0.0.1:8001
# Optional: override ICE servers (JSON array). Otherwise fetched from GET /api/v1/config/ice
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
